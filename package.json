{
  "name": "viewer",
  "private": true,
  "version": "1.7.0",
  "description": "Client Windows natif pour serveur Emby",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wails:exe": "npm run build && node scripts/build-wails-exe.ts",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:web": "npm run lint && npm run check && npm run test && npm run build",
    "verify:go": "node scripts/verify-go.ts",
    "verify": "npm run verify:web && npm run verify:go"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "7zip-bin": "5.2.0",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
