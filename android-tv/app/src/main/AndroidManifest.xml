<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update through PackageInstaller -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV-first, but also installable on a box that does not declare leanback -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!--
          The launcher entries, one per season (brand/LauncherIcon.kt switches them): exactly one is enabled.
          MainActivity has no launcher filter of its own, or the app would show twice. The launcher keeps the
          alias names: never rename them.
        -->
        <activity-alias
            android:name=".Launcher_default"
            android:banner="@drawable/banner"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/icon"
            android:label="${appLabel}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher_epiphany"
            android:banner="@drawable/banner_epiphany"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/icon_epiphany"
            android:label="${appLabel}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
